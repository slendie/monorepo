{
    "name": "slendie/auth",
    "description": "Autenticação para a Slendie: login por sessão, remember-me, tokens de API, middlewares auth/guest, @auth/@guest.",
    "type": "library",
    "license": "MIT",
    "keywords": ["slendie", "auth", "authentication", "login", "tokens"],
    "homepage": "https://slendie.lcloss.dev",
    "authors": [
        { "name": "Luciano Closs", "email": "lcloss@gmail.com" }
    ],
    "support": {
        "issues": "https://github.com/slendie/monorepo/issues",
        "source": "https://github.com/slendie/auth"
    },
    "require": {
        "php": "^8.5",
        "slendie/framework": "^4.0"
    },
    "autoload": {
        "psr-4": { "Slendie\\Auth\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Slendie\\Auth\\Tests\\": "tests/" }
    },
    "extra": {
        "branch-alias": { "dev-main": "4.x-dev" },
        "slendie": {
            "providers": ["Slendie\\Auth\\AuthServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
