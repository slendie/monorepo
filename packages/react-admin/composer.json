{
    "name": "slendie/react-admin",
    "description": "Painel de leads em React 19 + Vite + Tailwind para a Slendie, autenticado com slendie/auth.",
    "type": "library",
    "license": "MIT",
    "keywords": ["slendie", "admin", "react", "vite", "dashboard", "leads"],
    "homepage": "https://slendie.lcloss.dev",
    "authors": [
        { "name": "Luciano Closs", "email": "lcloss@gmail.com" }
    ],
    "support": {
        "issues": "https://github.com/slendie/monorepo/issues",
        "source": "https://github.com/slendie/react-admin"
    },
    "require": {
        "php": "^8.5",
        "slendie/framework": "^4.0",
        "slendie/auth": "^4.0"
    },
    "autoload": {
        "psr-4": { "Slendie\\ReactAdmin\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Slendie\\ReactAdmin\\Tests\\": "tests/" }
    },
    "extra": {
        "branch-alias": { "dev-main": "4.x-dev" },
        "slendie": {
            "providers": ["Slendie\\ReactAdmin\\ReactAdminServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
