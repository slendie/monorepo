<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Framework">
            <directory>framework/tests</directory>
        </testsuite>
        <testsuite name="Packages">
            <directory>packages/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>framework/src</directory>
            <directory>packages/*/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="DB_TEST_MYSQL_DSN" value="mysql:host=localhost;port=3306;dbname=slendie_test;charset=utf8mb4"/>
        <env name="DB_TEST_MYSQL_USER" value="root"/>
        <env name="DB_TEST_MYSQL_PASSWORD" value="root"/>
    </php>
</phpunit>
