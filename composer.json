{
    "name": "slendie/monorepo",
    "description": "Monorepo de desenvolvimento da Slendie v4 (framework, skeleton e packages). Não publicar.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        { "type": "path", "url": "framework", "options": { "symlink": true } },
        { "type": "path", "url": "skeleton", "options": { "symlink": true } },
        { "type": "path", "url": "packages/*", "options": { "symlink": true } }
    ],
    "require": {
        "php": "^8.5",
        "slendie/framework": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.26"
    },
    "autoload-dev": {
        "psr-4": {
            "Slendie\\Tests\\": "framework/tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:slow": "pest --group=slow --exclude-group=none",
        "test:coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
