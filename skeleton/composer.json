{
    "name": "slendie/slendie",
    "description": "Slendie — skeleton para landing pages e pequenos sites em PHP. Um Laravel light: composer create-project slendie/slendie meu-site",
    "type": "project",
    "license": "MIT",
    "keywords": ["framework", "skeleton", "mvc", "php", "blade", "landing-page", "starter"],
    "homepage": "https://slendie.lcloss.dev",
    "authors": [
        { "name": "Luciano Closs", "email": "lcloss@gmail.com" }
    ],
    "support": {
        "issues": "https://github.com/slendie/monorepo/issues",
        "source": "https://github.com/slendie/slendie"
    },
    "require": {
        "php": "^8.5",
        "slendie/framework": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php slendie package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php slendie key:generate --ansi",
            "@php slendie migrate --force --ansi",
            "@php -r \"echo PHP_EOL.'Pronto! Corre: php slendie serve  (http://127.0.0.1:8000)'.PHP_EOL;\""
        ],
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test",
        "fix": "pint",
        "serve": "@php slendie serve"
    },
    "extra": {
        "slendie": { "dont-discover": [] }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
